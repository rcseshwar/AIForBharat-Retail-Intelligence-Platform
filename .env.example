# Database
DATABASE_URL="postgresql://user:password@localhost:5432/retail_intelligence"

# Redis
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
OPENAI_MODEL="gpt-4-turbo"
MAX_QUERY_RESULTS="1000"
ALERT_THRESHOLD="0.2"
LOG_LEVEL="info"

# Note: OpenAI API key is now entered directly in the application interface